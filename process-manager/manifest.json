{
  "id": "process-manager",
  "name": "进程管理",
  "version": "1.6.0",
  "plugin_type": "tab",
  "author": "linyuhc001",
  "description": "进程 / 连接与端口 / 文件占用 三合一系统检视插件，基于本地伴随服务 process-service（Restart Manager 通道），守护进程管理员上下文直连，支持结束进程树与强制断连。",
  "entry": "index.html",
  "min_host_version": "0.9.4",
  "permissions": [
    "storage"
  ],
  "service": {
    "executable": "sidecar/process-service.exe",
    "args": [
      "--serve",
      "--port",
      "19100"
    ],
    "elevated": true,
    "auto_start": true,
    "auto_stop": true,
    "port": 19100,
    "health_url": "http://127.0.0.1:19100/api/health"
  },
  "window": {
    "width": 1024,
    "height": 720,
    "resizable": true,
    "decorations": true,
    "transparent": false,
    "always_on_top": false,
    "skip_taskbar": false
  }
}
